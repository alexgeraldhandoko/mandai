# The mobile app reads only EXPO_PUBLIC_* values. Never put secrets here.
# Use your computer's LAN address when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Backend configuration (copy these lines to server/.env).
PORT=4000
AI_PROVIDER=bedrock
TRANSCRIPTION_PROVIDER=openai
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
CORS_ORIGIN=*

