PORT=4000

# AI_PROVIDER chooses the image-analysis implementation.
# Supported values: bedrock | openai
AI_PROVIDER=bedrock

# Speech transcription is deliberately separate. Amazon Bedrock handles the
# multimodal image reasoning; OpenAI is the lightweight MVP transcription path.
TRANSCRIPTION_PROVIDER=openai

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Use a specific origin in production. "*" is convenient for local Expo testing.
CORS_ORIGIN=*

